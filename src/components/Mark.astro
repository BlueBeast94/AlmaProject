---
/** Brand artwork, exported from the vectors in the brand manual. */
import wordmark from '../assets/brand/wordmark.svg?raw';
import flourish from '../assets/brand/flourish-pair.svg?raw';
import monogram from '../assets/brand/monogram.svg?raw';
import logo from '../assets/brand/logo.svg?raw';

const marks = { wordmark, flourish, monogram, logo };

interface Props {
  name: keyof typeof marks;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<span class:list={['mark', className]} aria-hidden="true" set:html={marks[name]} />
