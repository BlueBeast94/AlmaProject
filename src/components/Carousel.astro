---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { gallery } from '../data/site';

interface Slide {
  name: string;
  alt: string;
  width: number;
  height: number;
  src?: string;
  srcset?: string;
  video?: string;
  poster?: string;
}

/* Everything in src/assets/gallery/ appears here, ordered by file name. */
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/gallery/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}', { eager: true });
const videos = import.meta.glob<{ default: string }>('/src/assets/gallery/*.mp4', { eager: true, query: '?url' });
const posters = import.meta.glob<{ default: ImageMetadata }>('/src/assets/gallery/posters/*.jpg', { eager: true });

const baseName = (path: string) => path.split('/').pop()!.replace(/\.[^.]+$/, '');
const describe = (name: string) => name.replace(/^\d+[-_ ]*/, '').replace(/[-_]+/g, ' ') || 'Fotografía de ALMA';

const fromImages = await Promise.all(
  Object.entries(images).map(async ([path, module]): Promise<Slide> => {
    const file = module.default;
    const widths = [480, 800, 1200, 1600, 2000].filter((w) => w < file.width).concat(Math.min(file.width, 2400));
    const image = await getImage({ src: file, widths, format: 'webp', quality: 80 });
    const name = baseName(path);
    return { name, alt: describe(name), width: file.width, height: file.height, src: image.src, srcset: image.srcSet.attribute };
  }),
);

const fromVideos = await Promise.all(
  Object.entries(videos).map(async ([path, module]): Promise<Slide> => {
    const name = baseName(path);
    const poster = posters[`/src/assets/gallery/posters/${name}.jpg`]?.default;
    const still = poster ? await getImage({ src: poster, format: 'webp', quality: 76 }) : undefined;
    return { name, alt: describe(name), width: poster?.width ?? 9, height: poster?.height ?? 16, video: module.default, poster: still?.src };
  }),
);

const fromFolder = [...fromImages, ...fromVideos].sort((a, b) => a.name.localeCompare(b.name, undefined, { numeric: true }));

const url = (id: string, w: number) =>
  `https://images.unsplash.com/${id}?auto=format&fit=crop&q=74&w=${w}&h=${Math.round((w * 2) / 3)}`;

const placeholders: Slide[] = gallery.map((p) => ({
  name: p.id,
  alt: p.alt,
  width: 1400,
  height: 933,
  src: url(p.id, 1400),
  srcset: [800, 1400, 2000].map((w) => `${url(p.id, w)} ${w}w`).join(', '),
}));

const slides = fromFolder.length > 0 ? fromFolder : placeholders;
const sizesFor = (s: Slide) => (s.height > s.width ? '(max-width: 760px) 84vw, 34vw' : '(max-width: 760px) 84vw, 66vw');
---

<section class="gallery" id="galeria" aria-roledescription="carrusel" aria-label="Galería" data-carousel>
  <div class="gallery__track" tabindex="0" aria-label="Fotografías. Usá las flechas para moverte." data-track>
    {
      slides.map((s, i) => (
        <figure class="slide" role="group" aria-label={`${i + 1} de ${slides.length}`}>
          {s.video ? (
            <video src={s.video} poster={s.poster} width={s.width} height={s.height} muted loop playsinline preload="none" aria-label={s.alt} />
          ) : (
            <img src={s.src} srcset={s.srcset} sizes={sizesFor(s)} alt={s.alt} width={s.width} height={s.height} loading="lazy" decoding="async" draggable="false" />
          )}
        </figure>
      ))
    }
  </div>
  <div class="gallery__bar">
    <button class="arrow" type="button" aria-label="Foto anterior" data-prev>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12H3m7-7-7 7 7 7" /></svg>
    </button>
    <p class="label" aria-live="polite" data-count>1 / {slides.length}</p>
    <button class="arrow" type="button" aria-label="Foto siguiente" data-next>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h18m-7-7 7 7-7 7" /></svg>
    </button>
  </div>
</section>
